          "sort": "desc"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "editorMode": "code",
          "expr": "sum by (method, uri) (rate(http_server_requests_seconds_sum{job=\"todo-app\", uri=~\"$uri\", uri!~\"/actuator.*\"}[$__rate_interval])) / sum by (method, uri) (rate(http_server_requests_seconds_count{job=\"todo-app\", uri=~\"$uri\", uri!~\"/actuator.*\"}[$__rate_interval]))",
